{
  "name": "@xyl2024/pi-work",
  "version": "0.6.11",
  "description": "Pi Work — Web UI for the pi coding agent",
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "nextjs",
    "claude",
    "anthropic",
    "sse"
  ],
  "homepage": "https://github.com/xyl2024/pi-work#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyl2024/pi-work.git"
  },
  "bugs": {
    "url": "https://github.com/xyl2024/pi-work/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "pi-work": "bin/pi-work.js"
  },
  "files": [
    "bin",
    "scripts/copy-pdf-worker.mjs",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -p 30141",
    "dev:isolated": "node scripts/dev-isolated.mjs",
    "clean:stale-build-types": "node scripts/clean-stale-build-types.mjs",
    "prebuild": "node scripts/clean-stale-build-types.mjs",
    "build": "next build --webpack",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "start": "next start -p 30141",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "pnpm version patch --no-git-tag-version && pnpm run build && pnpm publish --access public"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.11",
    "@colbymchenry/codegraph": "1.6.0",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@lobehub/icons": "^5.6.0",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/turndown": "^5.0.6",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "beautiful-mermaid": "^1.1.3",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "domhandler": "^5.0.3",
    "echarts": "^6.1.0",
    "elkjs": "^0.11.1",
    "entities": "^7.0.1",
    "fast-xml-parser": "^5.11.1",
    "generative-loaders": "^0.1.1",
    "gpt-tokenizer": "^4.0.0",
    "html-react-parser": "^6.1.3",
    "html-to-image": "^1.11.13",
    "isomorphic-dompurify": "^3.18.0",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.37.0",
    "monaco-editor": "^0.52.2",
    "morphicons": "^1.7.0",
    "motion": "12.42.2",
    "next": "16.2.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "^9.2.1",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "typebox": "1.3.7",
    "undici": "^8.10.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.7",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/qrcode": "^1.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "postcss": "^8",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
